# Copy to .env and adjust. Every variable is optional.

# Where the SQLite database, attachments and generated secret key live.
AMS_DATA_DIR=./data

# Bind address and port of the web server.
AMS_HOST=0.0.0.0
AMS_PORT=8080

# Encrypts SMTP passwords and webhook secrets stored in the database.
# Use a long random string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
# When unset, a key is generated once in $AMS_DATA_DIR/secret.key. Losing it makes saved
# credentials unreadable, so back it up with the database.
AMS_SECRET_KEY=

# First operator account, created only while the database has no operator.
# Leave the password empty to have a random one generated and printed once in the logs.
AMS_ADMIN_USERNAME=admin
AMS_ADMIN_PASSWORD=

# Public address of the dashboard, used for links in notifications when the
# "Dashboard address" setting in the UI is empty.
AMS_PUBLIC_URL=http://localhost:8080

# Session cookie "Secure" flag: auto (default: set when served over HTTPS), true or false.
AMS_COOKIE_SECURE=auto

# Operator session lifetime in hours (renewed while in use).
AMS_SESSION_TTL_HOURS=12

# Hard limit for any HTTP request body, base64 attachments included (MB).
AMS_MAX_BODY_MB=50

# Proxies trusted for X-Forwarded-For / X-Forwarded-Proto (comma-separated IPs, or *).
AMS_FORWARDED_ALLOW_IPS=127.0.0.1

# debug, info, warning, error
AMS_LOG_LEVEL=info
